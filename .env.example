# URL base de la API backend (opcional para desarrollo local)
VITE_API_URL=http://localhost:5173/api

# URL de tu proyecto Supabase (en Supabase: Project Settings > API)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública anónima de Supabase (anon / publishable key)
VITE_SUPABASE_ANON_KEY=tu_clave_anonima_publica_aqui


